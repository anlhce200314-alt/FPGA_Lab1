//=============================================================================
// Physical Constraints File for Lab01FAP201 – FPGA Programming
// Target Device: GW5A-LV25UG324C2/I1
// Board: Xiaomeige ACG525
// Description: Pin assignments for 3 switches and 3 LEDs
//=============================================================================
//=============================
// Button INPUTS (KEY buttons)
//=============================
// Button 1 is KEY0 onboard
IO_LOC "bt1" B16;
IO_PORT "bt1" PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
// Button 2 is KEY1 onboard
IO_LOC "bt2" A15;
IO_PORT "bt2" PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
// Button 3 is KEY2 onboard
IO_LOC "bt3" C15;
IO_PORT "bt3" PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
//==============
// LED OUTPUTS
//==============
// LED 1 is LED0 onboard
IO_LOC "led1" D14;
IO_PORT "led1" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// LED 2 is LED1 onboard
IO_LOC "led2" C14;
IO_PORT "led2" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// LED 3 is LED2 onboard
IO_LOC "led3" B9;
IO_PORT "led3" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;